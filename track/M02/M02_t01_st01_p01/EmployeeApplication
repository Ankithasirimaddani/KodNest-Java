class Employee{
    String name;
    int age;
    double height;

    Employee()
    {
        name = "Ankitha";
        age = 21;
        height = 5.6;
    }
    Employee(String name){
        this.name = name;
    }
    Employee(String name,int age,double height)
    {
        this.name = name;
        this.age = age;
        this.height = height;
    }

    void display()
    {
        System.out.println("Name = " + name);
        System.out.println("Age = " + age);
        System.out.println("Height = " + height);
    }
}
public class EmployeeApplication{

    public static void main(String[]args)
    {
        Employee e1 = new Employee("Rani",12,5.5);
        e1.display();

        Employee e2 = new Employee("Siri");
        e2.display();

        Employee e3 = new Employee()
        e3.display();      
        
    }
}